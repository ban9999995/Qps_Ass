# 应用显示名称
APP_NAME=电商运营助手
# 运行环境：development、test 或 production
APP_ENV=development
# 是否开启调试模式；生产环境请设置为 false
DEBUG=true
# 后端 API 路由统一前缀
API_PREFIX=/api
# 允许访问后端的前端地址，多个地址使用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MySQL 异步连接地址，请替换用户名、密码、主机和数据库名
DATABASE_URL=mysql+asyncmy://<username>:<password>@<host>:3306/<database>
# Redis 通用连接地址
REDIS_URL=redis://<host>:6379/0
# Celery 消息代理地址
CELERY_BROKER_URL=redis://<host>:6379/1
# Celery 任务结果存储地址
CELERY_RESULT_BACKEND=redis://<host>:6379/2
# 本地素材、导入文件和报告的根目录
DATA_DIR=./data
# 大语言模型服务接口地址
LLM_BASE_URL=https://<llm-provider>/v1
# 大语言模型服务密钥，请勿提交真实密钥
LLM_API_KEY=<your-llm-api-key>
# 大语言模型名称
LLM_MODEL=<your-llm-model>
# 视觉语言模型服务接口地址
VLM_BASE_URL=https://<vlm-provider>/v1
# 视觉语言模型服务密钥，请勿提交真实密钥
VLM_API_KEY=<your-vlm-api-key>
# 图片生成服务接口地址
IMAGE_GENERATION_BASE_URL=https://<image-provider>/v1
# 图片生成服务密钥，请勿提交真实密钥
IMAGE_GENERATION_API_KEY=<your-image-api-key>
# 视频生成服务接口地址
VIDEO_GENERATION_BASE_URL=https://<video-provider>/v1
# 视频生成服务密钥，请勿提交真实密钥
VIDEO_GENERATION_API_KEY=<your-video-api-key>
# 模型接口请求超时时间，单位：秒
MODEL_TIMEOUT_SECONDS=60
# 素材任务总超时时间，单位：秒
TASK_TIMEOUT_SECONDS=600
# 素材任务最大重试次数
TASK_MAX_RETRIES=3
# 前端轮询素材任务的间隔，单位：秒
TASK_POLL_SECONDS=3
# 日志级别：DEBUG、INFO、WARNING 或 ERROR
LOG_LEVEL=INFO
